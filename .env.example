# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox personal (buyer) account email that receives the demo invoices
PAYPAL_RECIPIENT_EMAIL=

# One LLM provider (Anthropic preferred)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
